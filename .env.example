# ---------------------------------------------------------------------------
# Chemin de la base SQLite du mode pilote
# ---------------------------------------------------------------------------
# Contient le journal des comparaisons (le livrable de l'essai) et un
# instantané de la flotte, rechargé au démarrage.
#
# Défaut : data/pilote.db (relatif à la racine du projet)
#
# Sur Railway : monter un volume et pointer cette variable dessus, sinon le
# système de fichiers est éphémère et l'essai repart de zéro à chaque déploiement.
#   DISPATCH_DB_PATH=/data/pilote.db
#
# DISPATCH_DB_PATH=data/pilote.db

# ---------------------------------------------------------------------------
# Injecté automatiquement par Railway — ne pas définir manuellement
# ---------------------------------------------------------------------------
#   PORT  →  utilisé dans le Procfile / startCommand
